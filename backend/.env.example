# ============ LLM Config ============
# Primary: DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# Fallback: Qwen (Tongyi)
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

# ============ Voice Config (M2) ============
# Volcano Engine (Doubao)
VOLCANO_STT_APP_ID=your_volcano_app_id
VOLCANO_STT_TOKEN=your_volcano_token
VOLCANO_TTS_APP_ID=your_volcano_app_id
VOLCANO_TTS_TOKEN=your_volcano_token

# ============ LiveKit ============
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ============ Database ============
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_interview
REDIS_URL=redis://localhost:6379/0

# ============ App ============
DEBUG=true
LOG_LEVEL=INFO
